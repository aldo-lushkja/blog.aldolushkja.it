---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Aldo Lushkja — Blog"
  description="Notes on software engineering, cloud infrastructure, and the rest of the IT world — from someone who builds it for a living."
>
  <SiteHeader />
  <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
    <div class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Latest posts</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Software engineering, cloud architecture, and everything else in IT that keeps me up at night.
      </p>
    </div>
    {posts.length === 0 ? (
      <p class="text-gray-500 dark:text-gray-400">No posts yet — check back soon.</p>
    ) : (
      <div class="divide-y divide-gray-100 dark:divide-gray-900">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </main>
  <SiteFooter />
</BaseLayout>
