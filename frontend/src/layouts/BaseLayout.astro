---
import '@/styles/input.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  updatedTime,
  tags = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Aldo Lushkja — Blog';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Aldo Lushkja" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Structured Data (Schema.org) -->
    {type === 'article' ? (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalURL.toString(),
        },
        headline: title,
        description,
        image: [new URL(image, Astro.site).toString()],
        datePublished: publishedTime,
        dateModified: updatedTime ?? publishedTime,
        inLanguage: 'en-US',
        keywords: tags.join(', '),
        author: {
          '@type': 'Person',
          name: 'Aldo Lushkja',
          url: 'https://aldolushkja.it',
          sameAs: [
            'https://github.com/aldo-lushkja',
            'https://aldolushkja.it'
          ],
        },
        publisher: {
          '@type': 'Organization',
          name: siteName,
          url: Astro.site?.toString(),
          logo: {
            '@type': 'ImageObject',
            url: new URL('/favicon.svg', Astro.site).toString(),
          },
        },
      })} />
    ) : (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: Astro.site?.toString(),
        description,
        author: {
          '@type': 'Person',
          name: 'Aldo Lushkja',
          url: 'https://aldolushkja.it',
        },
      })} />
    )}

    <script is:inline>
      // Avoid FOUC: read persisted theme before paint.
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = stored ? stored === 'dark' : prefersDark;
      document.documentElement.classList.toggle('dark', isDark);
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
  </body>
</html>
