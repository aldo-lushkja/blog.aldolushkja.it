---
import ThemeToggle from '@/components/ThemeToggle.astro';
---

<header class="border-b border-gray-100 dark:border-gray-900">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-6 sm:px-6">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-gray-900 dark:text-white">
      Aldo Lushkja <span class="text-brand font-normal">/ blog</span>
    </a>
    <nav class="flex items-center gap-5 text-sm text-gray-600 dark:text-gray-400">
      <a href="/" class="link-underline hover:text-gray-900 dark:hover:text-white">Posts</a>
      <a href="/rss.xml" class="link-underline hover:text-gray-900 dark:hover:text-white">RSS</a>
      <a href="https://aldolushkja.it" class="link-underline hover:text-gray-900 dark:hover:text-white">aldolushkja.it</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
